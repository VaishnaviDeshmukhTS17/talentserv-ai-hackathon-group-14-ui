# Frontend — PropIntel React app
# API requests are proxied to the Python backend in dev (see vite.config.js)

# Optional: set explicit backend URL (leave empty to use Vite proxy /api → localhost:8000)
VITE_API_BASE_URL=

# Firebase (same as before)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
