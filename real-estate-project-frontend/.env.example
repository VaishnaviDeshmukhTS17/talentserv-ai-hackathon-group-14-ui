# PropIntel Frontend — environment variables
# Copy to .env for local development: cp .env.example .env

# ── Local development ─────────────────────────────────────────────────────────
# Leave VITE_API_BASE_URL empty — Vite proxies /api/* to localhost:8000 (see vite.config.js)

# ── Production (Vercel) ───────────────────────────────────────────────────────
# REQUIRED: set VITE_API_BASE_URL to your deployed FastAPI backend URL (no trailing slash).
# Example: https://propintel-api.onrender.com
#
# Also update backend CORS_ORIGINS to include your Vercel URL, e.g.:
#   https://your-app.vercel.app
#
# If using Firebase auth, add your Vercel domain under Firebase Console →
# Authentication → Settings → Authorized domains.

VITE_API_BASE_URL=

# ── Firebase (optional — sandbox auth used when missing) ─────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
